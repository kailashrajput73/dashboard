# API origin, no /api suffix. Vite only exposes names that start with VITE_.
# Restart `npm run dev` after any change here.
#
# Cursor cloud / single port forward: leave empty — requests use /api via vite.config proxy → :8001
# VITE_BACKEND_URL=
#
# Direct API (local or forward BOTH 5173 and 8001):
# VITE_BACKEND_URL=http://127.0.0.1:8001
#
# Production API (when not using the Vite proxy):
# VITE_BACKEND_URL=https://dash.buildmate24x7.com
